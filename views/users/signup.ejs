<% layout("/layouts/boilerplate.ejs") %>
<div class="row">
    <div class="col-md-6 offset-md-3">
        <h3>Create an Account</h3>
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input id="username" name="user[username]" type="text" class="form-control" minlength="3" required>
                <div class="invalid-feedback">Enter a username with at least 3 characters.</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="user[email]" type="email" class="form-control" required>
                <div class="invalid-feedback">Enter a valid email address.</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="user[password]" type="password" class="form-control" minlength="8" required>
                <div class="invalid-feedback">Use a password with at least 8 characters.</div>
            </div>
            <button class="btn btn-dark">Sign up</button>
        </form>
    </div>
</div>
